    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.14.2",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.4.3",
    "next-intl": "^4.13.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "rough-notation": "^0.5.1",
    "svg-dotted-map": "^2.1.0",
