    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.6.0",
  "description": "Open-source travel editorial and tour showcase built with Next.js, React, TypeScript, and Tailwind CSS.",
