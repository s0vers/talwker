{
  "name": "talkwer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3560",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:filenames": "node scripts/check-kebab-case.mjs",
    "check:image-sizes": "node scripts/check-image-sizes.mjs",
    "check:public-image-bytes": "node scripts/check-public-image-bytes.mjs",
    "compress:public-images": "node scripts/compress-public-images.mjs",
    "detect": "node scripts/impeccable-detect.mjs",
    "doctor": "node scripts/impeccable-doctor.mjs",
    "hooks": "node .impeccable/hooks/pre-commit.mjs",
    "impeccable:detect": "node scripts/impeccable-detect.mjs",
    "impeccable:doctor": "node scripts/impeccable-doctor.mjs",
    "impeccable:hooks": "node .impeccable/hooks/pre-commit.mjs",
    "deps:outdated": "pnpm outdated || true",
    "deps:audit": "pnpm audit --prod",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:filenames && pnpm check:image-sizes && pnpm check:public-image-bytes && pnpm build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "package:theme": "node scripts/package-theme.mjs",
    "check:marketplace": "node scripts/check-marketplace.mjs",
    "audit:preview-links": "node scripts/audit-preview-links.mjs",
    "audit:mobile": "node scripts/audit-mobile-lcp.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
